#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# The installer drive's first console (specs/004-installer-drive FR-007): logged in as
# root by getty -n -l, the greeting, then a login shell.
cd /root 2>/dev/null || cd /
export HOME=/root
# the board's command line hides the console cursor (for the splash); a shell needs it
echo 1 > /sys/module/vt/parameters/global_cursor_default 2>/dev/null
printf '\033[?25h'
/usr/sbin/glassine-drive welcome
exec /bin/sh -l
