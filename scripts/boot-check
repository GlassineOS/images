#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""Check an exported boot image against the parts it was packed from and the device's
board.conf. Runs on the build computer:

    docker buildx build --platform linux/arm64 --target boot-export -o type=local,dest=out .
    docker buildx build --platform linux/arm64 --target kernel-export -o type=local,dest=out .
    docker buildx build --platform linux/arm64 --target dtb-export -o type=local,dest=out .
    docker buildx build --platform linux/arm64 --target initramfs-export -o type=local,dest=out .
    scripts/boot-check out [DEVICE] [--cmdline-extra WORDS]

Checks the Android boot image header v0 fields against targets/<device>/board.conf
(and nothing else: no reference image), that the kernel is Image.gz with the device tree
appended and the ramdisk is the initramfs followed by board.conf, the size limits
(PART_SIZE, RAMDISK_MAX when set), the glassine.img= id, the boot record's fields, the
initramfs's name and manifest, and the device's select record.

The board's CMDLINE never carries glassine.devmode (boot's rule for a board's constant
command line). --cmdline-extra WORDS: the image was built with CMDLINE_EXTRA=WORDS (a
trial), so it is checked against the board.conf scripts/bootimg.sh packs then: the
target's with a last line CMDLINE="<board CMDLINE> <WORDS>". Without it the image's
command line must carry no glassine.devmode: a build that isn't a trial never does.
"""
import hashlib, os, re, shlex, struct, sys

HERE = os.path.dirname(os.path.abspath(__file__))
errors = []


def check(cond, msg):
    print(('ok:   ' if cond else 'FAIL: ') + msg)
    if not cond:
        errors.append(msg)


def newc(entries):
    """The packer's board.conf archive: newc, owner 0:0, mtime 0, 4-byte aligned, TRAILER!!!."""
    out = bytearray()
    for ino, (name, mode, data) in enumerate(entries + [('TRAILER!!!', 0, b'')], 1):
        nb = name.encode() + b'\0'
        fields = (ino, mode, 0, 0, 1, 0, len(data), 0, 0, 0, 0, len(nb), 0)
        out += b'070701' + b''.join(b'%08X' % f for f in fields) + nb
        out += b'\0' * (-len(out) % 4) + data
        out += b'\0' * (-len(out) % 4)
    return bytes(out)


def read(p):
    with open(p, 'rb') as f:
        return f.read()


def kv(data):
    out = {}
    for line in data.decode().splitlines():
        line = line.strip()
        if line and not line.startswith('#') and '=' in line:
            k, v = line.split('=', 1)
            out[k.strip()] = (shlex.split(v) or [''])[0]
    return out


def only(d, suffix):
    names = [n for n in sorted(os.listdir(d)) if n.endswith(suffix)] if os.path.isdir(d) else []
    if len(names) != 1:
        sys.exit(f'boot-check: expected one {suffix} in {d}, found {names}')
    return os.path.join(d, names[0])


def record(path):
    rec = {}
    for line in read(path).decode().splitlines():
        k, _, v = line.partition('=')
        rec[k] = v
    return rec


def main(out, device, extra=''):
    board_path = os.path.join(HERE, '..', 'targets', device, 'board.conf')
    target_conf = read(board_path)
    check('glassine.devmode' not in kv(target_conf).get('CMDLINE', ''),
          f'targets/{device}/board.conf CMDLINE carries no glassine.devmode')
    # the board.conf the image was packed from (scripts/bootimg.sh)
    extra = ' '.join(extra.split())
    conf = target_conf
    if extra:
        print(f'note: CMDLINE_EXTRA={extra} (a trial image)')
        conf += f'CMDLINE="{kv(target_conf)["CMDLINE"]} {extra}"\n'.encode()
    board = kv(conf)
    num = lambda k: int(board[k], 0)
    img_path = only(os.path.join(out, 'bootimg'), '.img')
    img = read(img_path)
    rec = record(img_path[:-4] + '.manifest')
    check(rec.get('format') == '1', 'boot record format=1')
    for k in ('id', 'device', 'kernel', 'dtb', 'initramfs', 'cmdline', 'board', 'release', 'size', 'sha256'):
        check(k in rec, f'boot record has {k}')

    check(img[:8] == b'ANDROID!', 'boot image magic')
    (ksz, kaddr, rsz, raddr, ssz, saddr, tags, ps, hver, osv) = struct.unpack_from('<10I', img, 8)
    check(ps == num('PAGE_SIZE'), f'page size {ps} from board.conf')
    check(kaddr == num('KERNEL_ADDR'), f'kernel address {kaddr:#x} from board.conf')
    check(raddr == num('RAMDISK_ADDR'), f'ramdisk address {raddr:#x} from board.conf')
    check(saddr == num('SECOND_ADDR') and ssz == 0, f'second address {saddr:#x}, no second stage')
    check(tags == num('TAGS_ADDR'), f'tags address {tags:#x} from board.conf')
    check(osv == num('OS_VERSION'), f'os version {osv:#x} from board.conf')
    check(hver == 0, 'header version 0')
    name = img[48:64].rstrip(b'\0').decode()
    check(name == board.get('NAME', 'glassine')[:15], f'name {name!r} from board.conf')
    cmd = img[64:576].rstrip(b'\0').decode()
    check(cmd == f'{board["CMDLINE"]} glassine.img={rec.get("id")}', f'cmdline: {cmd}')
    if not extra:
        check('glassine.devmode' not in cmd, 'no glassine.devmode on the command line (no CMDLINE_EXTRA)')

    rel = rec.get('kernel', '')
    image_gz = read(os.path.join(out, 'modules', rel, 'Image.gz'))
    dtb = read(os.path.join(out, 'boot', 'dtb', rec.get('dtb', '') + '.dtb'))
    initramfs = read(os.path.join(out, 'boot', 'initramfs', rec.get('initramfs', '') + '.cpio.gz'))
    up = lambda n: (n + ps - 1) // ps * ps
    kernel = img[ps:ps + ksz]
    ramdisk = img[ps + up(ksz):ps + up(ksz) + rsz]
    check(kernel == image_gz + dtb, f'kernel = {rel}/Image.gz + {rec.get("dtb")}.dtb')
    pad = initramfs + b'\0' * (-len(initramfs) % 4)
    check(ramdisk.startswith(pad), f'ramdisk starts with {rec.get("initramfs")}.cpio.gz')
    check(ramdisk[len(pad):] == newc([('etc', 0o40755, b''), ('etc/glassine-boot', 0o40755, b''),
                                      ('etc/glassine-boot/board.conf', 0o100644, conf)]),
          'ramdisk ends with exactly the board.conf archive (etc/glassine-boot/board.conf)')
    ident = hashlib.sha256(kernel + b'\0' + ramdisk + b'\0' + board['CMDLINE'].encode()).hexdigest()[:16]
    check(ident == rec.get('id') and os.path.basename(img_path) == ident + '.img', f'id {ident} (glassine.img=)')
    check(len(img) == ps + up(ksz) + up(rsz), 'image length = header + padded kernel + padded ramdisk')
    check(len(img) <= num('PART_SIZE'), f'size {len(img)} <= PART_SIZE {num("PART_SIZE")}')
    if board.get('RAMDISK_MAX'):
        check(rsz <= num('RAMDISK_MAX'), f'ramdisk {rsz} <= RAMDISK_MAX {num("RAMDISK_MAX")}')
    else:
        print(f'note: board.conf sets no RAMDISK_MAX (ramdisk {rsz} bytes)')
    check(board.get('DEVICE') == device, f'board.conf DEVICE={board.get("DEVICE")}')
    check(rec.get('dtb', '').startswith(device + '@'), f'device tree {rec.get("dtb")} is for {device}')

    # the initramfs: <commit12>@<sha256-16>, and its manifest
    iid = rec.get('initramfs', '')
    m = re.fullmatch(r'([0-9a-f]{12})@([0-9a-f]{16})', iid)
    check(bool(m), f'initramfs {iid} is <commit12>@<sha256-16>')
    isha = hashlib.sha256(initramfs).hexdigest()
    irec = record(os.path.join(out, 'boot', 'initramfs', iid + '.manifest'))
    check(irec.get('format') == '1', 'initramfs manifest format=1')
    for k in ('commit', 'sha256', 'state_format', 'needs', 'features'):
        check(k in irec, f'initramfs manifest has {k}')
    if m:
        check(isha[:16] == m.group(2), 'initramfs name carries its sha256-16')
        check(re.fullmatch(r'[0-9a-f]{40}', irec.get('commit', '')) is not None
              and irec['commit'][:12] == m.group(1), f'initramfs manifest commit={irec.get("commit")}')
    check(irec.get('sha256') == isha, 'initramfs manifest sha256')

    # the device's update
    sel_path = os.path.join(out, 'select', device)
    sel = record(sel_path) if os.path.isfile(sel_path) else {}
    want = {'format': '1', 'device': device, 'kernel': rel, 'dtb': rec.get('dtb'), 'initramfs': iid}
    check(sel == want, f'select/{device} = {want}' + ('' if sel == want else f' (is {sel})'))
    check(rec.get('size') == str(len(img)), 'boot record size')
    check(rec.get('sha256') == hashlib.sha256(img).hexdigest(), 'boot record sha256')
    check(rec.get('board') == hashlib.sha256(conf).hexdigest(), 'boot record board = sha256 of board.conf')
    check(rec.get('device') == device, f'boot record device={rec.get("device")}')
    check(rec.get('cmdline') == board['CMDLINE'], 'boot record cmdline = board.conf CMDLINE')
    print(f'boot-check: {len(errors)} failure(s)')
    return 1 if errors else 0


if __name__ == '__main__':
    a = sys.argv[1:]
    extra = ''
    if '--cmdline-extra' in a:
        i = a.index('--cmdline-extra')
        if i + 1 >= len(a):
            print(__doc__, file=sys.stderr)
            sys.exit(2)
        extra = a[i + 1]
        del a[i:i + 2]
    if len(a) not in (1, 2):
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    sys.exit(main(a[0], a[1] if len(a) == 2 else 'onyx-noteair', extra))
