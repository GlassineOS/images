#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""Make the installer's release folder from one build: the system partition as a btrfs
pool image, the boot image, the RAM environment, and release.json (docs/artifacts.md,
"Releases"; GlassineOS/installer spec 002, FR-019a).

    scripts/pool-image [OPTIONS] ARTIFACTS TARGET

  ARTIFACTS  an artifacts folder scripts/build wrote (docs/artifacts.md); read only,
             unless the release goes to its default place inside it
  TARGET     the target whose build is released

Options:
  --build ID         the build (default: the newest build record of TARGET)
  --ramenv DIR       a ramenv-export (docker buildx ... --target ramenv-export -o
                     type=local,dest=DIR): DIR/ramenv/<id>.img and its .manifest. Without
                     it the release has no ram-environment role
  --boot DIR         a GlassineOS/boot checkout whose glassine-deploy lays the pool out,
                     instead of the build's boot commit (its boot record's boot_commit,
                     fetched from the Dockerfile's BOOT): a trial (boot:<commit12>)
  --boot-commit SHA  the same, a commit fetched from BOOT
  --out DIR          the release folder (default ARTIFACTS/TARGET/releases/<build-id>);
                     must not exist; written under a .tmp name and renamed when complete
  --margin MIB       free space left in the pool image beyond what it allocates
                     (default 64)
  --repo DIR         the checkout with the Dockerfile and targets/ (default: this one)

The base role is one btrfs file system, made in a privileged container
(scripts/pool-image-container.sh, loop device on a tmpfs, like materialize): mkfs.btrfs
on a sparse file, GlassineOS/boot's `glassine-deploy init POOL --install-marker` on the
empty, mounted pool (bases/, modules/, state/, the install marker state/install), the
base's full stream received into bases/ (read-only, the received UUID the base record
names, so later bases arrive as deltas), the modules stream of the build's kernel
release into modules/, then shrunk to what it allocates plus the margin (a whole MiB),
checked (btrfs check, no mixed block groups) and read back. The image holds no free
space for the partition: the first start grows the file system to the partition.

release.json (release_format 1):
  base             kind btrfs-pool-image, min_partition_bytes by spec 002 FR-019a (one
                   base's used bytes + 4 x 64 MiB + the modules' used bytes, x 1.25, at
                   least 1 GiB, a whole MiB; never below the image)
  kernel           the build's boot image, for boot_b: kind raw-image,
                   min_partition_bytes = the target's board.conf PART_SIZE (every later
                   boot image is packed to that limit)
  ram-environment  with --ramenv: kind raw-image, min_partition_bytes = its size
and, beside what the installer reads (readers ignore unknown keys): target, build,
trial, trial_reasons, missing (the roles this folder doesn't supply: boot-loader,
partition-layout, recovery) and per role where it came from.

Environment: POOL_IMAGE_TMPFS (default 8g), POOL_IMAGE_IMG (the largest pool tried,
default 8 GiB), MATERIALIZE_IMAGE (default alpine:3.24).
Exit: 0 done, 1 failed (nothing left at --out), 2 usage.
"""
import json, os, re, shutil, subprocess, sys, tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import glassine_pins  # noqa: E402

BUILD_ID = re.compile(r'(\d{8}-\d{6})(?:-(\d+))?')
MISSING = ['boot-loader', 'partition-layout', 'recovery']


class Fail(Exception):
    pass


def record(path):
    with open(path) as f:
        lines = f.read().splitlines()
    if not lines or lines[0] != 'format=1':
        raise Fail(f'{path}: first line is not format=1')
    rec = {}
    for line in lines:
        k, _, v = line.partition('=')
        rec.setdefault(k, v)
    return rec


def shell_conf(path, key):
    """KEY=value from a board.conf (sh syntax, plain values)."""
    with open(path) as f:
        for line in f:
            m = re.fullmatch(rf'{key}=["\']?([^"\'\s]*)["\']?\s*', line)
            if m:
                return m.group(1)
    return None


def newest_build(adir, target):
    bdir = os.path.join(adir, target, 'builds')
    found = []
    for n in os.listdir(bdir) if os.path.isdir(bdir) else []:
        m = BUILD_ID.fullmatch(n)
        if m and os.path.isfile(os.path.join(bdir, n, 'manifest')):
            found.append(((m.group(1), int(m.group(2) or 0)), n))
    if not found:
        raise Fail(f'{bdir}: no build records')
    return sorted(found)[-1][1]


def checked(path, sha, what):
    if not os.path.isfile(path):
        raise Fail(f'{what}: no {path}')
    if glassine_pins.sha256_file(path) != sha:
        raise Fail(f'{what}: {path} is not the file its record names (sha256)')


def git_head(d):
    try:
        out = subprocess.run(['git', '-C', d, 'rev-parse', 'HEAD'], capture_output=True,
                             text=True, check=True).stdout.strip()
        dirty = subprocess.run(['git', '-C', d, 'status', '--porcelain'], capture_output=True,
                               text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        raise Fail(f'{d}: not a git checkout')
    return out, bool(dirty)


def fetch_boot(url, commit, dest):
    rc = subprocess.run(['sh', os.path.join(HERE, 'git-fetch.sh'), 'pool-image boot', url, commit,
                         dest]).returncode
    if rc != 0:
        raise Fail(f'fetching boot {commit} from {url} failed')


def link_or_copy(src, dst):
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    try:
        os.link(src, dst)
    except OSError:
        shutil.copyfile(src, dst)


def entry(path, rel, kind, minimum, **extra):
    e = {'file': rel, 'sha256': glassine_pins.sha256_file(path), 'size': os.path.getsize(path),
         'kind': kind, 'min_partition_bytes': minimum}
    e.update(extra)
    return e


def usage():
    print(__doc__, file=sys.stderr)
    sys.exit(2)


def parse(argv):
    o = {'build': None, 'ramenv': None, 'boot': None, 'boot_commit': None, 'out': None, 'margin': '64',
         'repo': os.path.dirname(HERE)}
    pos = []
    it = iter(argv)
    for a in it:
        if a in ('--build', '--ramenv', '--boot', '--boot-commit', '--out', '--margin', '--repo'):
            v = next(it, None)
            if v is None:
                usage()
            o[a[2:].replace('-', '_')] = v
        elif a.startswith('-'):
            usage()
        else:
            pos.append(a)
    if len(pos) != 2 or (o['boot'] and o['boot_commit']) or not o['margin'].isdigit():
        usage()
    return o, pos


def main(argv):
    sys.stdout.reconfigure(line_buffering=True)
    o, (adir, target) = parse(argv)
    adir = os.path.abspath(adir)
    repo = os.path.abspath(o['repo'])
    bid = o['build'] or newest_build(adir, target)
    if not BUILD_ID.fullmatch(bid):
        raise Fail(f'build {bid!r}: not a build id')
    m = record(os.path.join(adir, target, 'builds', bid, 'manifest'))
    if m.get('target') != target:
        raise Fail(f'build {bid}: target={m.get("target")}, not {target}')
    base, rel, img = m['base'], m['kernel_release'], m['bootimg']
    brec = record(os.path.join(adir, target, 'bases', base, 'record'))
    ruuid = brec.get('received_uuid', '')
    if not ruuid or ruuid != m.get('received_uuid'):
        raise Fail(f'base {base}: received UUID {ruuid!r} (record) vs {m.get("received_uuid")!r} (build)')
    stream = os.path.join(target, 'bases', base, 'base.btrfs.zst')
    checked(os.path.join(adir, stream), brec['stream_sha256'], f'base {base}')
    mstream = os.path.join('modules', rel + '.btrfs.zst')
    checked(os.path.join(adir, mstream), m['modules_stream_sha256'], f'modules {rel}')
    bimg = os.path.join(adir, 'bootimg', img + '.img')
    brec_img = record(os.path.join(adir, 'bootimg', img + '.manifest'))
    if brec_img.get('kernel') != rel:
        raise Fail(f'boot image {img} carries kernel {brec_img.get("kernel")}, the build {rel}')
    checked(bimg, brec_img['sha256'], f'boot image {img}')
    part = shell_conf(os.path.join(repo, 'targets', target, 'board.conf'), 'PART_SIZE')
    if not part or not part.isdigit() or os.path.getsize(bimg) > int(part):
        raise Fail(f'targets/{target}/board.conf: no PART_SIZE, or the boot image is larger')

    ramenv = None
    if o['ramenv']:
        rd = os.path.join(os.path.abspath(o['ramenv']), 'ramenv')
        ids = sorted(n[:-4] for n in os.listdir(rd) if re.fullmatch(r'[0-9a-f]{16}\.img', n)) \
            if os.path.isdir(rd) else []
        if len(ids) != 1:
            raise Fail(f'{rd}: expected one <id>.img, found {ids}')
        rrec = record(os.path.join(rd, ids[0] + '.manifest'))
        if rrec.get('device') != target:
            raise Fail(f'ram environment {ids[0]} is for {rrec.get("device")}, not {target}')
        checked(os.path.join(rd, ids[0] + '.img'), rrec['sha256'], f'ram environment {ids[0]}')
        ramenv = (ids[0], os.path.join(rd, ids[0] + '.img'), rrec)

    why = [w for w in m.get('trial_reasons', '').split() if w] if m.get('trial') == 'yes' else []
    out = os.path.abspath(o['out'] or os.path.join(adir, target, 'releases', bid))
    if os.path.exists(out):
        raise Fail(f'{out} exists')
    os.makedirs(os.path.dirname(out), exist_ok=True)
    stage = tempfile.mkdtemp(prefix='.' + os.path.basename(out) + '.', suffix='.tmp',
                             dir=os.path.dirname(out))
    try:
        # the layout tool: boot at the build's boot commit, or the one given (a trial)
        work = os.path.join(stage, '.work')
        os.makedirs(work)
        boot_url = glassine_pins.build_args(os.path.join(repo, 'Dockerfile')).get('BOOT')
        if o['boot']:
            boot_dir = os.path.abspath(o['boot'])
            boot_commit, dirty = git_head(boot_dir)
            if dirty:
                raise Fail(f'{boot_dir}: uncommitted changes')
        else:
            boot_commit = o['boot_commit'] or m.get('boot_commit')
            if not boot_commit:
                raise Fail(f'build {bid}: no boot_commit')
            if not boot_url:
                raise Fail(f'{repo}/Dockerfile: no BOOT (the boot repository) to fetch from')
            boot_dir = os.path.join(work, 'boot')
            fetch_boot(boot_url, boot_commit, boot_dir)
        if boot_commit != m.get('boot_commit'):
            why.append(f'boot:{boot_commit[:12]}')
        print(f'pool-image: build {bid}: base {base}, kernel {rel}, boot image {img}; '
              f'layout by boot {boot_commit[:12]}')

        os.makedirs(os.path.join(stage, 'o'))
        cmd = ['docker', 'run', '--rm', '--privileged',
               '-e', f'BASE={base}', '-e', f'RUUID={ruuid}', '-e', f'STREAM={stream}',
               '-e', f'RELEASE={rel}', '-e', f'MSTREAM={mstream}',
               '-e', f'MARGIN={int(o["margin"]) << 20}',
               '-e', f'IMG={os.environ.get("POOL_IMAGE_IMG", str(8 << 30))}',
               '-e', f'TMPFS={os.environ.get("POOL_IMAGE_TMPFS", "8g")}',
               '-e', f'HOST_UID={os.getuid()}', '-e', f'HOST_GID={os.getgid()}',
               '-v', f'{adir}:/a:ro', '-v', f'{boot_dir}:/b:ro', '-v', f'{os.path.join(stage, "o")}:/o',
               '-v', f'{HERE}:/s:ro',
               os.environ.get('MATERIALIZE_IMAGE', 'alpine:3.24'), 'sh', '/s/pool-image-container.sh']
        rc = subprocess.run(cmd).returncode
        if rc != 0:
            raise Fail(f'the container failed (exit {rc})')
        res = {}
        with open(os.path.join(stage, 'o', 'result')) as f:
            for line in f.read().splitlines():
                k, _, v = line.partition('=')
                res[k] = v

        arts = {}
        pool_rel = f'base/{base}.pool.img'
        os.makedirs(os.path.join(stage, 'base'))
        os.rename(os.path.join(stage, 'o', 'pool.img'), os.path.join(stage, pool_rel))
        arts['base'] = entry(os.path.join(stage, pool_rel), pool_rel, 'btrfs-pool-image',
                             int(res['min_partition_bytes']), base=base, received_uuid=ruuid,
                             kernel_release=rel, layout_boot_commit=boot_commit)
        if arts['base']['sha256'] != res['sha256'] or arts['base']['size'] != int(res['size']):
            raise Fail('the pool image changed after the container hashed it')
        k_rel = f'kernel/{img}.img'
        link_or_copy(bimg, os.path.join(stage, k_rel))
        arts['kernel'] = entry(os.path.join(stage, k_rel), k_rel, 'raw-image', int(part),
                               bootimg=img, kernel_release=rel)
        if ramenv:
            r_rel = f'ram-environment/{ramenv[0]}.img'
            link_or_copy(ramenv[1], os.path.join(stage, r_rel))
            arts['ram-environment'] = entry(os.path.join(stage, r_rel), r_rel, 'raw-image',
                                            os.path.getsize(ramenv[1]), ramenv=ramenv[0],
                                            kernel_release=ramenv[2].get('kernel', ''))
        missing = MISSING + ([] if ramenv else ['ram-environment'])
        doc = {'release_format': 1, 'target': target, 'build': bid, 'trial': bool(why),
               'trial_reasons': why, 'missing': missing, 'artifacts': arts}
        with open(os.path.join(stage, 'release.json'), 'w') as f:
            json.dump(doc, f, indent=2, sort_keys=True)
            f.write('\n')
        shutil.rmtree(os.path.join(stage, 'o'))
        shutil.rmtree(work, ignore_errors=True)
        os.chmod(stage, 0o755)
        os.rename(stage, out)
    except BaseException:
        shutil.rmtree(stage, ignore_errors=True)
        raise
    print(f'pool-image: release {out}' + (f', trial ({" ".join(why)})' if why else ''))
    print(f'  base             {arts["base"]["size"] / 1048576:.0f} MiB, min partition '
          f'{arts["base"]["min_partition_bytes"] / 1048576:.0f} MiB')
    print(f'  missing          {" ".join(missing)}')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except (Fail, OSError, KeyError, ValueError) as e:
        print(f'pool-image: FAIL: {e}', file=sys.stderr)
        sys.exit(1)
