#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""Turn a base's tar export and the kernel-side exports into what a device receives (a
read-only base subvolume named by its id, its send streams, the modules subvolume's
stream) and the build's record (specs/001-base-build, FR-002/003, FR-005..017, FR-020,
FR-021). The artifacts folder and every record are defined in docs/artifacts.md.

    scripts/materialize [OPTIONS] BASE_TAR KERNEL_DIR TARGET ARTIFACTS

  BASE_TAR    the tar export of the base's last stage:
                docker buildx build --platform linux/arm64 -o type=tar,dest=BASE_TAR .
  KERNEL_DIR  the kernel, device-tree, initramfs and boot exports of TARGET in one
              directory (each with -o type=local,dest=KERNEL_DIR): modules/<release>/,
              boot/dtb/, boot/initramfs/, bootimg/<id>.{img,manifest}, select/<TARGET>
  TARGET      a directory under targets/; its base chain ends in device-<TARGET>
  ARTIFACTS   the artifacts folder; created if missing:
                <TARGET>/bases/<base-id>/    record, base.manifest, tree.manifest,
                                             packages, base.btrfs.zst,
                                             base.from-<parent>.btrfs.zst
                <TARGET>/builds/<build-id>/  manifest, kernel.manifest, boot.manifest, select
                modules/<release>.btrfs.zst, modules/<release>.manifest
                bootimg/<id>.img, .manifest
                boot/dtb/<device>@<id>.*, boot/initramfs/<commit12>@<id>.*

Options:
  --parent ID     the parent of a new base: a complete base of TARGET in ARTIFACTS.
                  Default: the base of the newest build record of TARGET
  --no-parent     a new base gets no parent (only its full stream)
  --arg NAME=VAL  a build argument the build used besides the Dockerfile's defaults
                  (repeat). Goes into the record (arg.*); one that differs from its
                  default makes the build a trial (arg:NAME), except the commit of an
                  input from a local checkout (local:NAME). DEVICE is set to TARGET
  --build-info F  what only the build command knows, key=value, one per line (# and
                  blank lines ignored). Keys:
                    images_commit        this repository's commit
                    images_clean         yes | no (uncommitted changes to tracked files, or
                                         untracked files git doesn't ignore)
                    input.<ARG>.tree     a git input's tree (<ARG>: its commit argument,
                                         e.g. LINUX_SDM660, DTB_COMMIT, BOOT_COMMIT)
                    input.<ARG>.local    yes = a local checkout, no = the pinned source
                    builder.<image>      a builder image's digest (sha256:...)
                    export.<export>.key  a registry export's key (docs/registry.md)
                    export.<export>.from <ref>@<digest> when it was pulled, built when
                                         it was built on this computer
                    unmerged             the inputs (<ARG> names) whose commits aren't on
                                         their branch, space-separated
                  Missing: images_commit and images_clean from git when this is a git
                  checkout, local = no, the others empty.
  --time T        the build's start, YYYY-MM-DDTHH:MM:SSZ (default: now, UTC). It
                  gives the build id, and the date of a base this build makes
  --repo DIR      the checkout with Dockerfile, stages/ and targets/ (default: this one)

In order: the base and kernel fit (FR-020: one release, named by the select record and
the boot record; the initramfs from the pinned boot commit; needs covered by provides,
which passes on empty lists), the host lock, the parent's completeness, then one
privileged container (alpine, loop devices on a tmpfs, scripts/materialize-container.sh):
extract the tar, check it for build leftovers, compute the content manifest and the id;
reuse a complete base with that id's tree16, or make a new one (base manifest in, the
parent's snapshot synced by content or a fresh subvolume, read-only, full stream and
delta); the modules stream unless ARTIFACTS has a complete one for the release; receive
every new stream back on fresh btrfs file systems and compare content manifests and
received UUIDs. Then the build record. Everything is written in a staging directory or
under a .tmp name and renamed into place once complete; the build record comes last.
Each step's time is printed (time <step> <seconds>).

The base manifest's needs and features are empty: GlassineOS/boot has no feature table
yet (conf/kernel-features), so there is nothing to derive them from.

Host lock (FR-003): flock on $XDG_RUNTIME_DIR/glassine-images-materialize.lock, or on
ARTIFACTS/.lock when XDG_RUNTIME_DIR is unset. It serializes the materializations of one
user session; a second one fails at once (exit 4).

Environment: MATERIALIZE_TMPFS (tmpfs size, default 8g), MATERIALIZE_IMG (bytes per
btrfs file, sparse, default 4 GiB), MATERIALIZE_IMAGE (default alpine:3.24).

Needs docker, python3 and sh on the host. Exit: 0 done (a new or a reused base),
1 failed (nothing new left in ARTIFACTS), 2 usage, 4 another materialization holds
the lock.
"""
import datetime, fcntl, os, re, shutil, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import glassine_pins  # noqa: E402

NAME = re.compile(r'[A-Za-z0-9._-]+')     # glassine-deploy's base names
BUILD_ID = re.compile(r'(\d{8}-\d{6})(?:-(\d+))?')


class Fail(Exception):
    pass


def read(p):
    with open(p, 'rb') as f:
        return f.read()


def record(path):
    """A key=value record (first line format=1); first match wins."""
    lines = read(path).decode().splitlines()
    if not lines or lines[0] != 'format=1':
        raise Fail(f'{path}: first line is not format=1')
    rec = {}
    for line in lines:
        k, _, v = line.partition('=')
        rec.setdefault(k, v)
    return rec


def write_record(path, items):
    for k, v in items:
        if '\n' in v or '=' in k:
            raise Fail(f'{path}: bad key or value {k}')
    with open(path, 'w') as f:
        f.write(''.join(f'{k}={v}\n' for k, v in items))


def only(d, suffix=''):
    names = sorted(n for n in os.listdir(d) if n.endswith(suffix) and not n.startswith('.')
                   and not n.endswith('.tmp')) if os.path.isdir(d) else []
    if len(names) != 1:
        raise Fail(f'{d}: expected one {suffix or "entry"}, found {names}')
    return names[0]


def words(v):
    return set(v.split())


def kernel_fit(kdir, target, base_needs, boot_commit):
    """FR-020's base and kernel fit, on the kernel-side exports."""
    rel = only(os.path.join(kdir, 'modules'))
    km_path = os.path.join(kdir, 'modules', rel, 'kernel.manifest')
    km = record(km_path)
    if km.get('release') != rel:
        raise Fail(f'{km_path}: release={km.get("release")} is not its directory {rel}')
    sel_path = os.path.join(kdir, 'select', target)
    if not os.path.isfile(sel_path):
        raise Fail(f'{sel_path}: no select record for {target}')
    sel = record(sel_path)
    img = only(os.path.join(kdir, 'bootimg'), '.manifest')[:-len('.manifest')]
    br_path = os.path.join(kdir, 'bootimg', img + '.manifest')
    br = record(br_path)
    if not os.path.isfile(os.path.join(kdir, 'bootimg', img + '.img')):
        raise Fail(f'{kdir}/bootimg: no {img}.img beside its record')
    checks = [
        (sel.get('kernel') == rel, f'select record kernel={sel.get("kernel")} is not the release under modules/ {rel}'),
        (br.get('kernel') == rel, f'boot record kernel={br.get("kernel")} is not the release under modules/ {rel}'),
        (br.get('id') == img, f'boot record id={br.get("id")} is not its name {img}'),
        (sel.get('device') == target and br.get('device') == target,
         f'select device={sel.get("device")}, boot record device={br.get("device")}: not {target}'),
        (sel.get('dtb') == br.get('dtb') and sel.get('initramfs') == br.get('initramfs'),
         'select record and boot record name other device trees or initramfs'),
    ]
    for good, msg in checks:
        if not good:
            raise Fail(msg)
    ird_path = os.path.join(kdir, 'boot', 'initramfs', sel['initramfs'] + '.manifest')
    dtb_path = os.path.join(kdir, 'boot', 'dtb', sel['dtb'] + '.manifest')
    for p in (ird_path, dtb_path):
        if not os.path.isfile(p):
            raise Fail(f'{p}: missing (the select record names it)')
    ird = record(ird_path)
    if boot_commit is not None and ird.get('commit') != boot_commit:
        raise Fail(f'the initramfs is from boot {ird.get("commit")}, the pinned boot commit is {boot_commit}')
    # boot's rule 1 and the base's coverage: always checked; empty lists pass
    provides = words(km.get('provides', ''))
    for who, needs in (('initramfs', words(ird.get('needs', ''))), ('base', base_needs)):
        if needs - provides:
            raise Fail(f'the kernel {rel} does not provide what the {who} needs: {sorted(needs - provides)}')
    print(f'materialize: kernel fit: {rel}, boot image {img}, initramfs {sel["initramfs"]}, '
          f'dtb {sel["dtb"]}; needs covered')
    return {'release': rel, 'bootimg': img, 'boot_commit': ird.get('commit', ''),
            'km_path': km_path, 'br_path': br_path, 'sel_path': sel_path}


def build_info(path, inputs):
    info = {}
    if not path:
        return info
    keys = re.compile(r'images_commit|images_clean|unmerged|builder\.[^=\s]+'
                      r'|input\.(\w+)\.(tree|local)|export\.([a-z0-9-]+)\.(key|from)')
    for n, line in enumerate(read(path).decode().splitlines(), 1):
        if not line.strip() or line.lstrip().startswith('#') or line == 'format=1':
            continue
        k, sep, v = line.partition('=')
        m = keys.fullmatch(k) if sep else None
        if not m:
            raise Fail(f'{path}:{n}: not a build-info key: {line!r}')
        if m.group(1) and m.group(1) not in inputs:
            raise Fail(f'{path}:{n}: {m.group(1)} is not a git input (no "# branch:" pin)')
        if m.group(3) and m.group(3) not in glassine_pins.REGISTRY_EXPORTS:
            raise Fail(f'{path}:{n}: {m.group(3)} is not a registry export')
        if k in info:
            raise Fail(f'{path}:{n}: {k} twice')
        info[k] = v
    for k in ('unmerged',):
        bad = words(info.get(k, '')) - set(inputs)
        if bad:
            raise Fail(f'{path}: unmerged names no git input: {sorted(bad)}')
    return info


def trial_reasons(info, inputs, args, defaults):
    """FR-017: local:<input> for each input from a local checkout; arg:<NAME> for each
    build argument that differs from its default, except a local input's commit (the
    checkout gives it: local says so); dirty or clean-unknown unless the checkout was
    clean."""
    local = [i for i in inputs if info.get(f'input.{i}.local') == 'yes']
    why = [f'local:{i}' for i in local]
    why += [f'arg:{a}' for a in args if args[a] != defaults.get(a) and a not in local]
    if info.get('images_clean') != 'yes':
        why.append('dirty' if info.get('images_clean') == 'no' else 'clean-unknown')
    return why


def git(repo, *args):
    try:
        return subprocess.run(['git', '-C', repo, *args], capture_output=True, text=True,
                              check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return None


def complete_base(adir, target, ident):
    """A base is complete when its directory holds its record, content manifest and full
    stream, its delta when the record names one, and the streams match the record."""
    d = os.path.join(adir, target, 'bases', ident)
    for f in ('record', 'tree.manifest', 'base.btrfs.zst'):
        if not os.path.isfile(os.path.join(d, f)):
            raise Fail(f'base {ident}: no {d}/{f} (incomplete)')
    rec = record(os.path.join(d, 'record'))
    pairs = [('base.btrfs.zst', rec.get('stream_sha256', ''))]
    if rec.get('delta'):
        pairs.append((rec['delta'], rec.get('delta_sha256', '')))
    for f, want in pairs:
        p = os.path.join(d, f)
        if not os.path.isfile(p) or glassine_pins.sha256_file(p) != want:
            raise Fail(f'base {ident}: {f} missing or not the stream its record names (cut?)')
    return rec


def builds(adir, target):
    """[(sort key, build id, record)] of the target's build records, oldest first."""
    out = []
    bdir = os.path.join(adir, target, 'builds')
    for n in os.listdir(bdir) if os.path.isdir(bdir) else []:
        m = BUILD_ID.fullmatch(n)
        p = os.path.join(bdir, n, 'manifest')
        if m and os.path.isfile(p):
            out.append(((m.group(1), int(m.group(2) or 0)), n, record(p)))
    return sorted(out)


def pick_parent(adir, target, named, none):
    if none:
        return ''
    if named:
        if not NAME.fullmatch(named) or named.startswith('.'):
            raise Fail(f'parent {named!r}: not a base name')
    else:
        recs = builds(adir, target)
        if not recs:
            return ''
        bid, rec = recs[-1][1], recs[-1][2]
        named = rec.get('base', '')
        print(f'materialize: parent: {named} (the base of build {bid}, the newest of {target})')
    complete_base(adir, target, named)
    return named


def take_lock(adir):
    rt = os.environ.get('XDG_RUNTIME_DIR')
    path = os.path.join(rt, 'glassine-images-materialize.lock') if rt else os.path.join(adir, '.lock')
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f'materialize: another materialization holds {path}', file=sys.stderr)
        sys.exit(4)
    return fd


def put(src, dst):
    """Copy src to dst under a .tmp name, then rename, unless dst holds the same bytes;
    other bytes under a name that is a content id are an error."""
    if os.path.exists(dst):
        if read(dst) != read(src):
            raise Fail(f'{dst} exists with other contents')
        return
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copyfile(src, dst + '.tmp')
    os.replace(dst + '.tmp', dst)


def usage():
    print(__doc__, file=sys.stderr)
    sys.exit(2)


def parse(argv):
    o = {'parent': None, 'no_parent': False, 'arg': {}, 'info': None, 'time': None,
         'repo': os.path.dirname(HERE)}
    pos = []
    it = iter(argv)
    for a in it:
        if a in ('--parent', '--arg', '--build-info', '--time', '--repo'):
            v = next(it, None)
            if v is None:
                usage()
            if a == '--arg':
                k, sep, val = v.partition('=')
                if not sep or not re.fullmatch(r'\w+', k):
                    usage()
                o['arg'][k] = val
            else:
                o[{'--build-info': 'info'}.get(a, a[2:])] = v
        elif a == '--no-parent':
            o['no_parent'] = True
        elif a.startswith('-'):
            usage()
        else:
            pos.append(a)
    if len(pos) != 4 or (o['parent'] and o['no_parent']):
        usage()
    if o['time']:
        try:
            o['time'] = datetime.datetime.strptime(o['time'], '%Y-%m-%dT%H:%M:%SZ')
        except ValueError:
            usage()
    return o, pos


def main(argv):
    sys.stdout.reconfigure(line_buffering=True)
    o, (tar, kdir, target, adir) = parse(argv)
    t_start = time.monotonic()
    start = o['time'] or datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None, microsecond=0)
    repo = os.path.abspath(o['repo'])
    dockerfile = os.path.join(repo, 'Dockerfile')
    stages_dir = os.path.join(repo, 'stages')
    if not NAME.fullmatch(target) or target.startswith('.'):
        raise Fail(f'target {target!r}: not a name')
    if not os.path.isfile(os.path.join(repo, 'targets', target, 'target')):
        raise Fail(f'{repo}/targets/{target}/target: no such target')
    if not os.path.isfile(tar):
        raise Fail(f'{tar}: no tar export')
    tar, kdir = os.path.abspath(tar), os.path.abspath(kdir)
    os.makedirs(adir, exist_ok=True)
    adir = os.path.abspath(adir)

    # the pins (FR-016) and what this build changed against them (FR-017)
    over = dict(o['arg'])
    over['DEVICE'] = target
    chain = glassine_pins.locked(glassine_pins.chain(dockerfile, target, over), stages_dir)
    if not chain:
        raise Fail(f'{dockerfile}: the chain of {target} has no stage with a lock')
    locks = glassine_pins.locks_digest(chain, stages_dir)
    all_locked = glassine_pins.locked(
        glassine_pins.reachable(dockerfile, [glassine_pins.BASE_STAGE, 'boot-export'], over), stages_dir)
    args = glassine_pins.build_args(dockerfile, over)
    defaults = glassine_pins.build_args(dockerfile, {'DEVICE': target})
    inputs = glassine_pins.branches(dockerfile)
    info = build_info(o['info'], inputs)
    if 'images_commit' not in info:
        c = git(repo, 'rev-parse', 'HEAD')
        info['images_commit'] = c.strip() if c else ''
    if 'images_clean' not in info:
        s = git(repo, 'status', '--porcelain')
        info['images_clean'] = '' if s is None else ('yes' if not s.strip() else 'no')
    why = trial_reasons(info, inputs, args, defaults)
    # no feature table exists yet (GlassineOS/boot conf/kernel-features): needs and
    # features stay empty until it does
    needs, features = '', ''
    print(f'materialize: chain {" → ".join(chain)}, locks {locks}')

    k = kernel_fit(kdir, target, words(needs), args.get('BOOT_COMMIT'))

    lock = take_lock(adir)
    try:
        return run(o, tar, kdir, target, adir, start, t_start, locks, all_locked, stages_dir,
                   args, inputs, info, why, needs, features, k)
    finally:
        os.close(lock)


def run(o, tar, kdir, target, adir, start, t_start, locks, all_locked, stages_dir,
        args, inputs, info, why, needs, features, k):
    parent = pick_parent(adir, target, o['parent'], o['no_parent'])
    rel = k['release']
    mstream = os.path.join(adir, 'modules', rel + '.btrfs.zst')
    mman = os.path.join(adir, 'modules', rel + '.manifest')
    # complete = both files under their final names (written as .tmp, then renamed)
    modules = 'have' if os.path.isfile(mstream) and os.path.isfile(mman) else 'new'

    tdir = os.path.join(adir, target)
    stage_rel = os.path.join(target, f'.incoming-{os.getpid()}')
    stage = os.path.join(adir, stage_rel)
    shutil.rmtree(stage, ignore_errors=True)
    os.makedirs(stage)
    try:
        with open(os.path.join(stage, 'base.manifest.in'), 'w') as f:
            f.write(f'format=1\nlocks={locks}\nneeds={needs}\nfeatures={features}\n')
        cmd = ['docker', 'run', '--rm', '--privileged',
               '-e', f'DATE={start:%Y%m%d}', '-e', f'TARGET={target}', '-e', f'PARENT={parent}',
               '-e', f'RELEASE={rel}', '-e', f'STAGE={stage_rel}', '-e', f'MODULES={modules}',
               '-e', f'TMPFS={os.environ.get("MATERIALIZE_TMPFS", "8g")}',
               '-e', f'IMG={os.environ.get("MATERIALIZE_IMG", str(4 << 30))}',
               '-e', f'HOST_UID={os.getuid()}', '-e', f'HOST_GID={os.getgid()}',
               '-v', f'{tar}:/in/base.tar:ro', '-v', f'{kdir}:/k:ro', '-v', f'{adir}:/a',
               '-v', f'{HERE}:/s:ro',
               os.environ.get('MATERIALIZE_IMAGE', 'alpine:3.24'), 'sh', '/s/materialize-container.sh']
        rc = subprocess.run(cmd).returncode
        if rc != 0:
            raise Fail(f'the container failed (exit {rc}); nothing was added to {adir}')
        res = {}
        for line in read(os.path.join(stage, 'result')).decode().splitlines():
            key, _, v = line.partition('=')
            res[key] = v
        ident, reused = res['id'], res['reused'] == 'yes'
        bdir = os.path.join(tdir, 'bases', ident)

        if reused:
            brec = complete_base(adir, target, ident)
        else:
            delta = f'base.from-{parent}.btrfs.zst' if parent else ''
            brec = {'base': ident, 'tree': res['tree'], 'parent': parent, 'uuid': res['uuid'],
                    'received_uuid': res['received_uuid'], 'build': '',
                    'stream_sha256': res['stream_sha256'], 'delta': delta,
                    'delta_sha256': res.get('delta_sha256', '')}

        # the build id: the start time, -N when taken
        os.makedirs(os.path.join(tdir, 'builds'), exist_ok=True)
        base_bid, n = f'{start:%Y%m%d-%H%M%S}', 1
        bid = base_bid
        while os.path.exists(os.path.join(tdir, 'builds', bid)):
            n += 1
            bid = f'{base_bid}-{n}'
        if not reused:
            brec['build'] = bid
            write_record(os.path.join(stage, 'base', 'record'),
                         [('format', '1')] + [(key, brec[key]) for key in
                          ('base', 'tree', 'parent', 'uuid', 'received_uuid', 'build',
                           'stream_sha256', 'delta', 'delta_sha256')])

        # the build record (FR-014) and the copies beside it
        msha = res.get('modules_sha256') or glassine_pins.sha256_file(mstream)
        m = [('format', '1'), ('build', bid), ('base', ident), ('target', target),
             ('tree', brec['tree']), ('parent', brec.get('parent', '')),
             ('reused', 'yes' if reused else 'no'),
             ('uuid', brec.get('uuid', '')), ('received_uuid', brec.get('received_uuid', '')),
             ('built', f'{start:%Y-%m-%dT%H:%M:%SZ}'),
             ('images_commit', info.get('images_commit', '')), ('images_clean', info.get('images_clean', '')),
             ('trial', 'yes' if why else 'no'), ('trial_reasons', ' '.join(why)),
             ('unmerged', info.get('unmerged', '')), ('locks', locks)]
        m += [(f'lock.{s}', glassine_pins.sha256_file(os.path.join(stages_dir, s, 'lock')))
              for s in all_locked]
        m += [(f'arg.{a}', v) for a, v in args.items()]
        for i, branch in inputs.items():
            m += [(f'input.{i}.commit', args.get(i, '')), (f'input.{i}.tree', info.get(f'input.{i}.tree', '')),
                  (f'input.{i}.branch', branch), (f'input.{i}.local', info.get(f'input.{i}.local', 'no'))]
        m += sorted((key, v) for key, v in info.items() if key.startswith('builder.'))
        for e in glassine_pins.REGISTRY_EXPORTS:
            m += [(f'export.{e}.{x}', info[f'export.{e}.{x}']) for x in ('key', 'from')
                  if f'export.{e}.{x}' in info]
        m += [('kernel_release', rel), ('bootimg', k['bootimg']), ('boot_commit', k['boot_commit']),
              ('stream', f'{target}/bases/{ident}/base.btrfs.zst'), ('stream_sha256', brec['stream_sha256']),
              ('delta', f'{target}/bases/{ident}/{brec["delta"]}' if brec.get('delta') else ''),
              ('delta_sha256', brec.get('delta_sha256', '')),
              ('modules_stream', f'modules/{rel}.btrfs.zst'), ('modules_stream_sha256', msha)]
        rdir = os.path.join(stage, 'build')
        os.makedirs(rdir)
        write_record(os.path.join(rdir, 'manifest'), m)
        shutil.copyfile(k['km_path'], os.path.join(rdir, 'kernel.manifest'))
        shutil.copyfile(k['br_path'], os.path.join(rdir, 'boot.manifest'))
        shutil.copyfile(k['sel_path'], os.path.join(rdir, 'select'))

        # into place, each by a rename of a complete file or directory: the kernel side,
        # then the base, the build record last
        if modules == 'new':
            os.makedirs(os.path.join(adir, 'modules'), exist_ok=True)
            os.replace(os.path.join(stage, 'modules.manifest'), mman + '.tmp')
            os.replace(mman + '.tmp', mman)
            os.replace(os.path.join(stage, 'modules.btrfs.zst'), mstream + '.tmp')
            os.replace(mstream + '.tmp', mstream)
        for sub in ('bootimg', os.path.join('boot', 'dtb'), os.path.join('boot', 'initramfs')):
            for name in sorted(os.listdir(os.path.join(kdir, sub))):
                put(os.path.join(kdir, sub, name), os.path.join(adir, sub, name))
        if not reused:
            os.makedirs(os.path.dirname(bdir), exist_ok=True)
            if os.path.exists(bdir):
                raise Fail(f'{bdir} exists')
            os.rename(os.path.join(stage, 'base'), bdir)
        os.rename(rdir, os.path.join(tdir, 'builds', bid))
    finally:
        shutil.rmtree(stage, ignore_errors=True)

    def size(p):
        return f'{os.path.getsize(p) / 1048576:.1f} MiB' if os.path.isfile(p) else '-'
    print(f'materialize: build {target}/builds/{bid}: base {ident}'
          + (' (reused)' if reused else ' (new)') + (f', trial ({" ".join(why)})' if why else ''))
    print(f'  full stream    {size(os.path.join(bdir, "base.btrfs.zst"))}')
    if not reused and parent:
        print(f'  delta from {parent}  {os.path.getsize(os.path.join(bdir, brec["delta"])) / 1024:.1f} KiB'
              f' ({int(res.get("delta_raw", 0)) / 1024:.1f} KiB raw)')
    print(f'  modules {rel}  {size(mstream)}' + (' (existing)' if modules == 'have' else ''))
    print(f'time {"materialize (total)":<26} {time.monotonic() - t_start:6.2f} s')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except (Fail, ValueError, OSError, KeyError) as e:
        print(f'materialize: FAIL: {e}', file=sys.stderr)
        sys.exit(1)
