# The sdm660 kernel: one compile for every device on this SoC whose target names
# kernel=sdm660. Read by scripts/kernel.sh; the source commit is pinned in the
# Dockerfile (LINUX_SDM660).
#   flavor     the release's flavor (GlassineOS/boot docs/kernel-artifacts.md)
#   defconfig  the base configuration, from the source's arch/arm64/configs
#   fragments  merged over it in this order, from the same directory; every option
#              in them must survive olddefconfig, or the build fails
flavor=sdm660
defconfig=sdm660_defconfig
fragments=onyx-noteair.config
