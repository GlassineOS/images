# The recovery kernel's options over the system kernel's configuration (the defconfig and
# fragments of ./kernel, every module there already left out), merged last and checked
# like the system kernel's: each line must be in the final configuration. The recovery
# needs (GlassineOS/boot spec 008, FR-014): storage, USB, the display, touch, the power
# key, the battery, the watchdog, the crash log, dm-crypt and btrfs. The system kernel
# builds most of it in already (eMMC, the USB controller and its gadget functions, the
# display controller, the power key, the battery and charger, the watchdog, ramoops,
# dm-crypt, btrfs and ext4); those lines are here so the build fails if one moves.

# No modules: the recovery loads none and its image carries none
# CONFIG_MODULES is not set

# Storage: the eMMC, the partitions' file systems, encrypted storage
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_VFAT_FS=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
# cryptsetup's keyslots through the kernel's crypto API (AF_ALG)
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# USB in device mode: the controller, its glue and PHY, the configfs gadget with
# FunctionFS (the core's vendor interface) and ACM (the console's serial function)
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_ACM=y

# The display: the display controller and DSI, the e-ink panel's link, and what
# glassine-epdd uses (KMS dumb buffers, udmabuf, the system dma-buf heap; memfd is in
# every kernel with SHMEM)
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_PANEL_ONYX_NA1_LINK=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_MEMFD_CREATE=y
# the frontlight's two channels
CONFIG_BACKLIGHT_LM3630A=y

# Touch, the power key, input events
CONFIG_TOUCHSCREEN_CYTTSP5=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INPUT_EVDEV=y

# The battery and charger (the panel's temperature is the battery's)
CONFIG_BATTERY_PMI8998_FG=y
CONFIG_CHARGER_QCOM_SMB2=y

# The watchdog and the crash log
CONFIG_QCOM_WDT=y
CONFIG_PSTORE_RAM=y

# GPIOs that two devices share go through this driver; a module in the system kernel
# (its default), built in here so a shared line's users don't wait for it forever
CONFIG_GPIO_SHARED_PROXY=y

# Left out, though the system kernel has them:
# - the speaker amplifier (the board fragment's module)
# CONFIG_SND_SOC_AW88194 is not set
# - firmware through a user-space helper: the recovery has none, and a request for a
#   file it doesn't carry (the GPU's microcode, at the display's first open) fails at once
# CONFIG_FW_LOADER_USER_HELPER is not set
# - debug information: the build's size, not the image's
CONFIG_DEBUG_INFO_NONE=y
# - hibernation: the recovery never resumes or writes an image of the system
# CONFIG_HIBERNATION is not set
# - file systems and block devices no GlassineOS partition uses
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_BLK_DEV_MD is not set
# CONFIG_BLK_DEV_NBD is not set
# - Android's binder and packet filtering
# CONFIG_ANDROID_BINDER_IPC is not set
# CONFIG_NETFILTER is not set
