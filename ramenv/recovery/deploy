#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# A confirmed DEPLOY action (docs/recovery.md): glassine-deploy's own operation, with
# --yes because the client has confirmed it. The daemon makes the deploy partitions
# writable for this run only. Exits with glassine-deploy's exit code.
#   deploy ACTION ID|- yes|no       (as describe)
. /lib/glassine-recovery/common.sh
[ $# = 3 ] || { echo "usage: deploy ACTION ID|- yes|no"; exit 2; }
act=$1 id=$2 d=''
[ "$id" != - ] || id=''
[ "$3" != yes ] || d=--discard-hibernation
offered "$act" || { echo "glassine-deploy has no $act operation"; exit 64; }
case $act in
select) set -- select "$id" --yes ;;
rollback) set -- rollback --yes ;;
reset) set -- reset --now --yes ;;
reset-full) set -- reset --full --now --yes ;;
remove) set -- remove "$id" --yes ;;
*) exit 64 ;;
esac
[ -z "$d" ] || set -- "$@" "$d"
echo "glassine-deploy $*"
"$GD" "$@"
