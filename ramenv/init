#!/bin/busybox sh
# SPDX-License-Identifier: GPL-2.0-or-later
# The RAM environment's init (docs/ramenv.md): started by the boot loader from the
# recovery partition (or once over USB, fastboot boot), it mounts nothing from the
# device's storage, offers the disks through glassine-ramread (read-only until the
# computer arms ranges for writing) and reboots when that ends. Device facts come from
# /etc/glassine/ramenv.conf (the device's ramenv/targets/<device>.conf):
#   RAMENV_DISKS            /sys/block name patterns to offer (required)
#   RAMENV_TRANSPORT        usb (default) or stream
#   RAMENV_STREAM           the character device of the stream transport
#   RAMENV_UDC              the USB device controller (empty: the first one there)
#   RAMENV_UDC_WAIT         seconds to wait for it (default 120: on some boards it binds late)
#   RAMENV_USB_VENDOR, RAMENV_USB_PRODUCT   the gadget's ids (default 0x1d6b 0x0104)
#   RAMENV_WATCHDOG         the hardware watchdog (default /dev/watchdog0)
#   RAMENV_WATCHDOG_TIMEOUT, RAMENV_CONNECT_WAIT, RAMENV_IDLE, RAMENV_OP_LIMIT,
#   RAMENV_DISK_WAIT        seconds, passed to glassine-ramread (its defaults when empty)
# The recovery (docs/recovery.md) is this init in an image that also holds
# /etc/glassine/recovery.version, glassine-deploy and the recovery's tools; there it
# also reads (the same file):
#   RECOVERY_SYSTEM_LABEL, RECOVERY_USERDATA_LABEL   the partitions (GPT names) that
#                           glassine-deploy works on; DEPLOY may write through them
#   RECOVERY_USERDATA_PREFIX   glassine-deploy's USERDATA_PREFIX (default media/glassine)
#   RECOVERY_IDLE           seconds without a request from any client before it
#                           restarts into the normal start (default 600)
#   RECOVERY_TOOL_LIMIT     seconds a glassine-deploy run may take (default 900)
#   RECOVERY_USB_SERIAL     yes: a USB serial function (ttyGS0) next to the vendor one
#   RECOVERY_TTYS           terminals the menu runs on (/dev names; console = /dev/console)
/bin/busybox mkdir -p /bin /proc /sys /dev /run /tmp
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
log() { echo "<5>glassine-ramenv: $*" > /dev/kmsg; }
# never returns: a short pause so the log is out, then the previous system starts
leave() { log "$*; rebooting in 5 s"; sleep 5; reboot -f; sleep 30; echo b > /proc/sysrq-trigger; }

RAMENV_DISKS='' RAMENV_TRANSPORT=usb RAMENV_STREAM='' RAMENV_UDC='' RAMENV_UDC_WAIT=120
RAMENV_USB_VENDOR=0x1d6b RAMENV_USB_PRODUCT=0x0104 RAMENV_WATCHDOG=/dev/watchdog0
RAMENV_WATCHDOG_TIMEOUT='' RAMENV_CONNECT_WAIT='' RAMENV_IDLE='' RAMENV_OP_LIMIT='' RAMENV_DISK_WAIT=''
RECOVERY=''
[ -r /etc/glassine/recovery.version ] && RECOVERY=1
RECOVERY_SYSTEM_LABEL='' RECOVERY_USERDATA_LABEL='' RECOVERY_USERDATA_PREFIX=media/glassine
RECOVERY_IDLE=600 RECOVERY_TOOL_LIMIT='' RECOVERY_USB_SERIAL='' RECOVERY_TTYS=''
[ -r /etc/glassine/ramenv.conf ] && . /etc/glassine/ramenv.conf
log "starting ($(uname -r))${RECOVERY:+, the recovery}"
[ -n "$RAMENV_DISKS" ] || leave "no RAMENV_DISKS in /etc/glassine/ramenv.conf"

set -f
set -- --ready /run/ramread.ready
for p in $RAMENV_DISKS; do set -- "$@" --disk "$p"; done
set +f
[ -n "$RAMENV_WATCHDOG" ] && set -- "$@" --watchdog "$RAMENV_WATCHDOG"
[ -n "$RAMENV_WATCHDOG_TIMEOUT" ] && set -- "$@" --watchdog-timeout "$RAMENV_WATCHDOG_TIMEOUT"
[ -n "$RAMENV_CONNECT_WAIT" ] && set -- "$@" --connect-wait "$RAMENV_CONNECT_WAIT"
[ -n "$RAMENV_IDLE" ] && set -- "$@" --idle "$RAMENV_IDLE"
[ -n "$RAMENV_OP_LIMIT" ] && set -- "$@" --op-limit "$RAMENV_OP_LIMIT"
[ -n "$RAMENV_DISK_WAIT" ] && set -- "$@" --disk-wait "$RAMENV_DISK_WAIT"

if [ -n "$RECOVERY" ]; then
	# no udev: partitions by their GPT names from sysfs; glassine-deploy gets a
	# configuration naming the devices themselves
	part() {	# part LABEL: the partition named LABEL on a served disk (RAMENV_DISKS);
		# none when two have that name (another system's disk, a USB stick)
		f='' n=0
		for p in $RAMENV_DISKS; do for u in /sys/block/$p/*/uevent; do
			[ -e "${u%/uevent}/partition" ] && grep -qx "PARTNAME=$1" "$u" 2>/dev/null || continue
			u=${u%/uevent}; f=${u##*/} n=$((n + 1))
		done; done
		[ $n -le 1 ] || { log "$n partitions named $1: none used" >&2; f=''; }
		echo "$f"
	}
	# a served disk there (any match of RAMENV_DISKS)
	disk_here() {
		for p in $RAMENV_DISKS; do for d in /sys/block/$p; do [ -e "$d" ] && return 0; done; done
		return 1
	}
	# the labels: up to RAMENV_DISK_WAIT for a first disk, then 5 s more for its
	# partitions; a disk without them (a stock table, while installing) goes on
	# without them, and DEPLOY has nothing to work on
	w=${RAMENV_DISK_WAIT:-60} t=0 settle=0 sysp='' udp=''
	while :; do
		[ -z "$RECOVERY_SYSTEM_LABEL" ] || sysp=$(part "$RECOVERY_SYSTEM_LABEL")
		[ -z "$RECOVERY_USERDATA_LABEL" ] || udp=$(part "$RECOVERY_USERDATA_LABEL")
		{ [ -n "$sysp" ] || [ -z "$RECOVERY_SYSTEM_LABEL" ]; } && { [ -n "$udp" ] || [ -z "$RECOVERY_USERDATA_LABEL" ]; } && break
		[ $t -lt "$w" ] || break
		if disk_here; then settle=$((settle + 1)); [ $settle -le 5 ] || break; fi
		sleep 1; t=$((t + 1))
	done
	log "system partition: ${sysp:-none} ($RECOVERY_SYSTEM_LABEL), userdata: ${udp:-none} ($RECOVERY_USERDATA_LABEL)"
	mkdir -p /etc/glassine /run/glassine
	{
		echo "SYSTEM_DEV=${sysp:+/dev/$sysp}"
		echo "SYSTEM_MNT=/run/glassine/system"
		echo "USERDATA_DEV=${udp:+/dev/$udp}"
		echo "USERDATA_MNT=/run/glassine/userdata"
		echo "USERDATA_PREFIX=$RECOVERY_USERDATA_PREFIX"
		echo "RUN_DIR=/run/glassine"
	} > /etc/glassine/deploy.conf
	set -- "$@" --tools /lib/glassine-recovery --socket /run/glassine-recovery.sock \
		--idle "$RECOVERY_IDLE" --connect-wait "$RECOVERY_IDLE"
	[ -n "$RECOVERY_TOOL_LIMIT" ] && set -- "$@" --tool-limit "$RECOVERY_TOOL_LIMIT"
	for p in $sysp $udp; do set -- "$@" --deploy-part "$p"; done
fi

G=/sys/kernel/config/usb_gadget/glassine-ramenv
case $RAMENV_TRANSPORT in
usb)
	mount -t configfs configfs /sys/kernel/config 2>/dev/null
	mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/ffs.ramread \
		|| leave "no USB gadget support (configfs)"
	echo "$RAMENV_USB_VENDOR" > $G/idVendor
	echo "$RAMENV_USB_PRODUCT" > $G/idProduct
	echo 0x0200 > $G/bcdUSB
	echo GlassineOS > $G/strings/0x409/manufacturer
	echo "GlassineOS RAM environment" > $G/strings/0x409/product
	echo "Disk reader" > $G/configs/c.1/strings/0x409/configuration
	echo 250 > $G/configs/c.1/MaxPower
	# Microsoft OS descriptors: Windows binds WinUSB to the vendor interface by itself
	if [ -d $G/os_desc ]; then
		echo 1 > $G/os_desc/use
		echo 0xcd > $G/os_desc/b_vendor_code
		echo MSFT100 > $G/os_desc/qw_sign
		ln -s $G/configs/c.1 $G/os_desc/ 2>/dev/null
	fi
	ln -s $G/functions/ffs.ramread $G/configs/c.1/
	# the recovery's USB serial: linked after the vendor function, which stays
	# interface 0 (its Microsoft OS descriptor names interface 0)
	if [ -n "$RECOVERY" ] && [ "$RECOVERY_USB_SERIAL" = yes ]; then
		mkdir -p $G/functions/acm.usb0 && ln -s $G/functions/acm.usb0 $G/configs/c.1/ \
			|| log "no USB serial function (acm); the menu is not on USB"
		echo "GlassineOS recovery" > $G/strings/0x409/product
	fi
	mkdir -p /dev/ffs-ramread
	mount -t functionfs ramread /dev/ffs-ramread || leave "cannot mount the FunctionFS instance"
	set -- --ffs /dev/ffs-ramread "$@"
	;;
stream)
	[ -n "$RAMENV_STREAM" ] || leave "RAMENV_TRANSPORT=stream without RAMENV_STREAM"
	set -- --stream "$RAMENV_STREAM" "$@"
	;;
*) leave "unknown RAMENV_TRANSPORT $RAMENV_TRANSPORT" ;;
esac

glassine-ramread "$@" &
pid=$!
# the descriptors are written (usb) or the stream is open; the disks take up to
# RAMENV_DISK_WAIT (60 s by default) to appear
t=0
while [ ! -e /run/ramread.ready ]; do
	kill -0 $pid 2>/dev/null || { wait $pid; leave "glassine-ramread stopped during setup (exit $?)"; }
	[ $t -lt 900 ] || leave "glassine-ramread not ready after 90 s"
	sleep 0.1; t=$((t + 1))
done

if [ "$RAMENV_TRANSPORT" = usb ]; then
	udc=$RAMENV_UDC t=0
	[ -n "$udc" ] || udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
	while [ -z "$udc" ] || [ ! -e "/sys/class/udc/$udc" ]; do
		[ $t -lt "$RAMENV_UDC_WAIT" ] || leave "no USB device controller after $RAMENV_UDC_WAIT s"
		sleep 1; t=$((t + 1))
		[ -n "$RAMENV_UDC" ] || udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
	done
	echo "$udc" > $G/UDC || leave "cannot bind the gadget to $udc"
	log "USB gadget on $udc ($RAMENV_USB_VENDOR:$RAMENV_USB_PRODUCT)"
fi

# the recovery's menu on each terminal, started again when it ends
if [ -n "$RECOVERY" ]; then
	for tty in $RECOVERY_TTYS; do
		case $tty in console) tty=/dev/console ;; *) tty=/dev/$tty ;; esac
		( while kill -0 $pid 2>/dev/null; do
			[ -c "$tty" ] && setsid sh -c "exec /lib/glassine-recovery/menu < $tty > $tty 2>&1"
			sleep 2
		done ) &
	done
fi

wait $pid
leave "glassine-ramread ended (exit $?)"
